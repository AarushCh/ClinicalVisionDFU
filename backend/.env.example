# ---------------------------------------------------------------------------
# Copy to .env (repo root or backend/) — it is gitignored. backend/envfile.py
# loads it automatically; real environment variables always take precedence.
# ---------------------------------------------------------------------------

# LLM assistant. Optional: without a key the app runs normally and the assistant
# panel shows setup instructions instead.
#
# NOTE the two similarly-named services:
#   groq     = groq.com, fast inference of open models, keys start  gsk_
#   grok     = x.ai's own model,                        keys start  xai-
# Transposing them gives a 400 "Incorrect API key". The provider is inferred
# from the key prefix anyway, so a mismatched LLM_PROVIDER still works.
LLM_PROVIDER=groq                  # groq | grok | nemotron
LLM_API_KEY=

# Optional. Any OpenAI-compatible chat-completions endpoint works.
#   groq     -> openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
#   grok     -> grok-3-mini
#   nemotron -> nvidia/llama-3.3-nemotron-super-49b-v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_TIMEOUT=45

# ---------------------------------------------------------------------------
# Analysis history (optional). Without these the dashboard keeps history in the
# browser's localStorage: per-device, not shared, cleared with site data.
# Supabase adds real accounts, cross-device history and image storage.
# The anon key is PUBLIC by design — row-level security is what protects data,
# so it belongs in the frontend build, not here.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------
# DFU_MODEL_PATH=model/dfu_resnet18_grouped.pt
# ALLOWED_ORIGINS=https://aarushch.github.io,http://localhost:3000
# MAX_UPLOAD_BYTES=15728640
# TORCH_THREADS=2
# PORT=10000
