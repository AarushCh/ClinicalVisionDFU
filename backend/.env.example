# ---------------------------------------------------------------------------
# LLM assistant (backend/llm.py). Optional: the app runs fine without it, the
# assistant panel just shows setup instructions instead.
#
# The key is read HERE, on the server. Never put it in the frontend: that build
# is a static export and any value in it is published to every visitor.
# ---------------------------------------------------------------------------

# Which provider preset to use: grok | nemotron
LLM_PROVIDER=grok

# Your key. Free tiers:
#   grok     -> https://console.x.ai        (also accepted as XAI_API_KEY)
#   nemotron -> https://build.nvidia.com    (also accepted as NVIDIA_API_KEY)
LLM_API_KEY=

# Optional overrides. Any OpenAI-compatible chat-completions endpoint works.
# LLM_MODEL=grok-3-mini
# LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_TIMEOUT=45

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------
# DFU_MODEL_PATH=model/dfu_resnet18_grouped.pt
# ALLOWED_ORIGINS=https://aarushch.github.io,http://localhost:3000
# MAX_UPLOAD_BYTES=15728640
# TORCH_THREADS=2
# PORT=10000
